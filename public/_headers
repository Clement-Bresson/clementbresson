# Hashed build assets never change: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Text endpoints read by crawlers and feed readers: short cache.
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  Cache-Control: public, max-age=3600
/rss.xml
  Cache-Control: public, max-age=3600
/fr/rss.xml
  Cache-Control: public, max-age=3600
