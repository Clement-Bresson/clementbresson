---
import BlogListPage from "../../../../components/BlogListPage.astro";
import { getTags, type TagSummary } from "../../../../lib/blog";

export async function getStaticPaths() {
  const tags = await getTags("fr");
  return tags.map((tag) => ({ params: { tag: tag.id }, props: { tag } }));
}

const { tag } = Astro.props as { tag: TagSummary };
---

<BlogListPage locale="fr" tag={tag} />
