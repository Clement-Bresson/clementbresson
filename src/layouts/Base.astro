---
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import portrait from '../assets/portrait.png';
import { getCopy, locales, type Locale } from '../i18n';
import { filePath } from '../lib/blog';
import { graph, personNode, websiteNode } from '../lib/schema';
import '../styles/global.css';

interface Props {
  locale: Locale;
  /** Locale-relative path of this page, e.g. `blog/my-post/`. Home is ''. */
  path?: string;
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: { src: ImageMetadata; alt: string };
  article?: { published: Date; modified?: Date; tags?: string[]; section?: string };
  /** Extra schema.org nodes merged into the page graph (Person + WebSite are always present). */
  schema?: Record<string, unknown>[];
  /** For utility pages (404) that must not be indexed. Skips canonical and hreflang too. */
  noindex?: boolean;
}

const { locale, path = '', ogType = 'website', article, schema = [], noindex = false } = Astro.props;
const t = getCopy(locale);
const title = Astro.props.title ?? t.metaTitle;
const description = Astro.props.description ?? t.metaDescription;

const canonical = getAbsoluteLocaleUrl(locale, path);
const alternates = locales.map((l) => ({ locale: l, href: getAbsoluteLocaleUrl(l, path) }));

const portraitImage = await getImage({ src: portrait, width: 1200, format: 'jpg', quality: 82 });
const portraitUrl = new URL(portraitImage.src, Astro.site).href;

const ogSource = Astro.props.ogImage;
const ogImage = ogSource
  ? await getImage({ src: ogSource.src, width: 1200, format: 'jpg', quality: 82 })
  : portraitImage;
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const ogImageAlt = ogSource?.alt ?? t.portraitAlt;

const jsonLd = graph([personNode(Astro.site, locale, portraitUrl), websiteNode(Astro.site, locale), ...schema]);
const rssHref = filePath(locale, 'rss.xml');
---

<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={t.name} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.locale} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', path)} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={t.blog.metaTitle} href={rssHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={t.ogLocale} />
    {locales
      .filter((l) => l !== locale)
      .map((l) => <meta property="og:locale:alternate" content={getCopy(l).ogLocale} />)}
    {
      article && (
        <>
          <meta property="article:author" content={t.name} />
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content={ogSource ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-geist" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
