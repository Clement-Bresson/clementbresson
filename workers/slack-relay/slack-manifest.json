{
  "display_information": {
    "name": "clementbresson.com",
    "description": "Blog article pipeline for clementbresson.com"
  },
  "features": {
    "bot_user": {
      "display_name": "clementbresson.com",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "channels:history", "groups:history"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://blog-slack-relay.clement0bresson.workers.dev/slack/events",
      "bot_events": ["message.channels", "message.groups"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
