{
  // Cloudflare Workers static-assets deployment (Cloudflare's recommended path
  // for new static sites). Deployed from GitHub Actions, see .github/workflows/deploy.yml.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clementbresson",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Custom domains. Enable once clementbresson.com is an active zone on
  // Cloudflare (nameservers switched at GoDaddy), otherwise `wrangler deploy` fails.
  // "routes": [
  //   { "pattern": "clementbresson.com", "custom_domain": true },
  //   { "pattern": "www.clementbresson.com", "custom_domain": true }
  // ],
  "observability": {
    "enabled": true
  }
}
