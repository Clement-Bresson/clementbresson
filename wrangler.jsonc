{
  // Cloudflare Workers static-assets deployment (Cloudflare's recommended path
  // for new static sites). Deployed from GitHub Actions, see .github/workflows/deploy.yml.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clementbresson",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // The site is served only on the custom domains below; the *.workers.dev
  // route and per-version preview URLs are off to avoid duplicate hosts.
  "workers_dev": false,
  "preview_urls": false,
  // Custom domains: clementbresson.com is an active zone on this account.
  "routes": [
    { "pattern": "clementbresson.com", "custom_domain": true },
    { "pattern": "www.clementbresson.com", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
  },
}
